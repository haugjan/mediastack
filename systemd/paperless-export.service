[Unit]
Description=Paperless exportieren und nach OneDrive spiegeln
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
Environment=RCLONE_CONFIG=/etc/rclone/rclone.conf
ExecStart=@REPO_DIR@/scripts/paperless-export.sh
TimeoutStartSec=4h
