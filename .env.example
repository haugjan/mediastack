################################################################################
# Vorlage. Nicht von Hand kopieren, sondern erzeugen lassen:
#
#     sudo ./setup.sh
#
# Der Installer fuellt alles ein, was er am System erkennen kann, und
# generiert die Secrets. Uebrig bleiben nur die Werte, die von aussen kommen
# und unten mit MANUELL markiert sind.
#
# .env ist in .gitignore und darf NIE committet werden.
################################################################################

# ------------------------------------------------------ Aktive Bereiche
# Steuert, WELCHE Container "docker compose up -d" ueberhaupt startet.
# setup.sh setzt das selbst, je nachdem welche Zugaenge du hast. Fehlt einer,
# laeuft der Dienst gar nicht, statt endlos neu zu starten.
#   torrent = Gluetun und qBittorrent   (braucht ProtonVPN-Schluessel)
#   usenet  = SABnzbd                   (braucht Usenet-Abo)
#   docs    = Paperless und Beiwagen
#   proxy   = Caddy mit eigenen Adressen (braucht Domain und Azure DNS)
#   extras  = Kometa und Scrutiny
COMPOSE_PROFILES=docs

# ------------------------------------------------------- Updates (optional)
# GITHUB_TOKEN ist OPTIONAL und fuer ein oeffentliches Repo unnoetig.
# Eintragen nur, wenn du einen eigenen privaten Fork nutzt oder in das
# Abfragelimit von GitHub laeufst. Contents Read-only genuegt dann.
GITHUB_REPO=haugjan/mediastack
GITHUB_TOKEN=

# ------------------------------------------------ Host & Benutzer (erkannt)
PUID=1000
PGID=1000
# getent group render | cut -d: -f3
RENDER_GID=104
TZ=Europe/Zurich

# ---------------------------------------------------------- Pfade (erkannt)
# EIN gemeinsames Dateisystem fuer Medien. Darunter torrents/, usenet/, media/.
DATA_ROOT=/mnt/data
# Paperless hat seinen eigenen Baum: data/, media/, consume/, export/.
PAPERLESS_ROOT=/mnt/data/paperless

# ------------------------------------------------------- Netzwerk (erkannt)
DOCKER_SUBNET=172.28.0.0/16
LAN_SUBNET=192.168.1.0/24
# tailscale ip -4 . Caddy fesselt die privaten Subdomains an diese Adresse.
TAILSCALE_IP=100.64.0.1

# ------------------------------------------------------------------- Domain
# Leer lassen heisst: Zugriff ueber http://<ip>:<port>. setup.sh fragt nach.
BASE_DOMAIN=
PAPERLESS_DOMAIN=
# MANUELL: Adresse fuer Let's-Encrypt-Benachrichtigungen.
ACME_EMAIL=

# ------------------------------------------- Azure DNS fuer das Zertifikat
# MANUELL. Service Principal mit der Rolle "DNS Zone Contributor", begrenzt
# auf genau deine DNS-Zone. Anlegen: docs/07-azure-dns.md
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------- ProtonVPN
# MANUELL. Proton-Konto > Downloads > WireGuard-Konfiguration.
# Beim Erzeugen NAT-PMP (Port Forwarding) UND P2P aktivieren, sonst bekommt
# qBittorrent keinen eingehenden Port.
PROTON_WG_PRIVATE_KEY=
VPN_COUNTRIES=Switzerland

# --------------------------------------------------------------------- Plex
# MANUELL. Token von https://www.plex.tv/claim/ , nur 4 Minuten gueltig.
# Nach dem ersten erfolgreichen Start kann der Wert leer bleiben.
PLEX_CLAIM=
PLEX_URL=http://host.docker.internal:32400
# AUTOMATISCH: setup.sh liest den Token aus Plex' eigener Preferences.xml,
# sobald der Server einmal mit deinem Konto verbunden war. Kometa und
# Tautulli brauchen ihn.
PLEX_TOKEN=

# ------------------------------------------------------ Musik ueber YouTube
# MANUELL. Lidarr holt Musik mit dem Plugin Tubifarry von YouTube. Tubifarry
# schlaegt jedes Album zuerst ueber die Spotify-API nach und sucht erst
# danach. Ohne diese Werte antwortet Spotify mit 403 und der Indexer liefert
# null Treffer, ohne dass es nach einem Fehler aussieht.
# Kostenlos anlegen unter https://developer.spotify.com/dashboard ,
# Create app, Redirect URI http://127.0.0.1:8686/callback , API "Web API".
# Die URI muss die IP sein: Spotify lehnt "localhost" als unsicher ab.
# Leer lassen heisst: kein Tubifarry, Musik nur ueber Prowlarr-Suchquellen.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------- API-Keys (automatisch!)
# Diese Werte liest setup.sh nach dem ersten Start selbst aus den
# Konfigurationsdateien der Apps aus. Nicht abtippen.
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
SABNZBD_API_KEY=
TAUTULLI_API_KEY=
OVERSEERR_API_KEY=

# MANUELL: in qBittorrent selbst gesetzt, wird von Homepage und Cleanuparr
# gebraucht.
QBIT_USER=admin
QBIT_PASS=

# ---------------------------------------------------- Paperless (generiert)
# setup.sh erzeugt diese drei. Nicht von Hand aendern, das Passwort steht
# auch in der Postgres-Datenbank.
PAPERLESS_SECRET_KEY=
PAPERLESS_DB_PASSWORD=
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# --------------------------------------------------- OneDrive (rclone)
# AUTOMATISCH: setup.sh richtet das in Schritt 7 ein, inklusive Anmeldung,
# verschluesseltem Remote und Timern. Von Hand ist hier nichts einzutragen.
#
# KEINE Kommentare hinter die Werte schreiben. Ein "#" mit Leerraum davor
# beginnt einen Kommentar und wird abgeschnitten, ein "#" ohne Leerraum
# davor gehoert zum Wert. Genau so liest es auch Docker Compose.
#
# Namen der beiden Remotes in der rclone-Konfiguration.
RCLONE_REMOTE=onedrive
RCLONE_REMOTE_CRYPT=onedrive-crypt
# Ordner im OneDrive.
RCLONE_INBOX_PATH=Scans
RCLONE_MIRROR_PATH=Paperless/Spiegel
RCLONE_BACKUP_PATH=Paperless/Backup
RCLONE_CONFIG_BACKUP_PATH=Mediastack/config
# GENERIERT beim Anlegen des verschluesselten Remotes, einmalig angezeigt.
# GEHOEREN IN DEN PASSWORTMANAGER: ohne diese zwei Werte ist das
# verschluesselte Backup nicht mehr lesbar, und hier liegen sie auf genau
# dem Rechner, den das Backup absichern soll.
RCLONE_CRYPT_PASSWORD=
RCLONE_CRYPT_SALT=

# ---------------------------------------------------------------- Dashboard
# Hostnamen, unter denen Homepage erreichbar sein darf (Pflicht seit v1.0).
HOMEPAGE_ALLOWED_HOSTS=localhost:3000

# ------------------------------------------------------- Radiomitschnitt
# Nur wirksam, wenn das Profil "radio" aktiv ist. Die Mindestbitrate meint
# die GEMESSENE, nicht die im Senderkatalog eingetragene: dort stehen
# Fantasiewerte bis 64000 kbit/s.
AIRCHECKARR_MIN_BITRATE=128
AIRCHECKARR_CODECS=mp3,aac
# Wie viele Sender gleichzeitig mitgehoert werden. Jeder kostet dauerhaft
# Bandbreite, und gespielt wird ohnehin ueberall dasselbe.
AIRCHECKARR_MAX_STATIONS=12
# ----------------------------------------------------------------- Backfill
# Titel pro Durchlauf. Hoehere Werte reizen Indexer-Limits aus und koennen
# zu Sperren fuehren. 3 bis 8 ist gesund.
BACKFILL_ITEMS_PER_CYCLE=5
BACKFILL_CYCLE_MINUTES=60
# true = zusaetzlich nach Qualitaets-Upgrades suchen (Cutoff Unmet).
# Beim Bibliotheksaufbau auf false lassen.
BACKFILL_SEARCH_UPGRADES=false
